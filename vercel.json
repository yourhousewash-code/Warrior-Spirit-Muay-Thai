{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/team/:id",
      "destination": "/api/team?id=:id"
    },
    {
      "source": "/calendar/club.ics",
      "destination": "/api/cal?feed=club"
    },
    {
      "source": "/calendar/me/:t",
      "destination": "/api/cal?feed=me&t=:t"
    }
  ],
  "redirects": [
    {
      "source": "/((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": ".*\\.vercel\\.app"
        }
      ],
      "destination": "https://www.warriorspiritmuaythai.co.uk/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/(coach|account)(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/api/(auth|pt|uploads|enquiry|gdrive)(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron?run=morning",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron?run=evening",
      "schedule": "0 17 * * *"
    }
  ],
  "functions": {
    "api/gdrive.js": {
      "maxDuration": 30
    }
  }
}